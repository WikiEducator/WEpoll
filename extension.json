{
	"name": "WEPoll",
	"version": "0.5",
	"author": [
		"[https://wikieducator.org/User:JimTittsler Jim Tittsler]"
	],
	"url": "http://wikieducator.org/Extension:WEPoll",
	"description": "add API calls for a simple Javascript poll",
	"license-name": "GPL-2.0-or-later",
	"type": "api",
  "requires": {
    "MediaWiki": ">= 1.35.0"
  },
	"AutoloadClasses": {
		"APIWEPoll": "WEpoll.php"
	},
	"APIModules": {
		"wepoll": "APIWEPoll"
	},
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteExtPath": "WEpoll"
  },
	"ResourceModules": {
		"ext.WEpoll": {
			"scripts": [ "wepoll.js" ],
			"styles": [ "wepoll.css" ],
			"dependencies": [ "mediawiki.api" ]
		}
	},
	"Hooks": {
		"ParserAfterTidy": "APIWEPoll::onParserAfterTidy"
	},
	"manifest_version": 2
}
